#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        BLUET_CLEAR {
            bindings = <&bt BT_CLR>;
            key-positions = <36 40 29 27>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // | TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | ESC |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | CTRL |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ALT  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | SHFT |

            bindings = <
&kp TAB    &kp Q  &kp W  &kp E  &kp R      &kp T        &kp Y    &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp ESC    &kp A  &kp S  &kp D  &kp F      &kp G        &kp H    &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z  &kp X  &kp C  &kp V      &kp B        &kp N    &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RALT
                         &mo 2  &kp LSHFT  &kp SPACE    &kp RET  &mo 1  &kp LGUI
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // |      |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     |    | 

            bindings = <
&none  &kp NUMBER_6  &kp N7        &kp N8        &kp N9        &kp N0       &kp LESS_THAN  &none     &kp GREATER_THAN  &none      &none  &kp BSPC
&none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5       &kp LEFT       &kp DOWN  &kp UP_ARROW      &kp RIGHT  &none  &none
&none  &none         &none         &none         &none         &none        &none          &none     &kp PLUS          &none      &none  &none
                                   &kp LGUI      &none         &kp SPACE    &kp RET        &none     &none
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |      |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // |      |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // |      |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     |     |

            bindings = <
&trans  &kp CARET        &kp AT       &kp HASH      &kp DLLR       &kp PIPE         &kp LESS_THAN  &kp LEFT_PARENTHESIS  &kp GREATER_THAN  &kp RPAR  &kp CARET      &kp BSPC
&trans  &kp EXCLAMATION  &kp PERCENT  &kp ASTERISK  &kp AMPERSAND  &kp BACKSLASH    &kp MINUS      &kp LEFT_BRACE        &kp EQUAL         &kp RBRC  &kp COLON      &kp GRAVE
&trans  &trans           &trans       &trans        &trans         &trans           &kp UNDER      &kp LEFT_BRACKET      &kp PLUS          &kp RBKT  &kp SEMICOLON  &kp TILDE
                                      &kp LGUI      &trans         &kp SPACE        &kp RET        &trans                &trans
            >;
        };
    };
};
